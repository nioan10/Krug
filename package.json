{
  "name": "krug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Private, self-hosted voice rooms for your people",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "node --env-file=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "dotnet publish desktop/capture/Krug.Capture.csproj -c Release -r win-x64 --self-contained true -o desktop/capture/publish",
    "desktop:build": "pnpm desktop:prepare && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "website.nioservices.krug",
    "productName": "Круг",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/update-controller.cjs",
      "desktop/preload.cjs",
      "desktop/picker*",
      "desktop/permission*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/capture/publish",
        "to": "capture"
      }
    ],
    "publish": [{ "provider": "generic", "url": "https://chat.nioservices.website/api/desktop-updates" }],
    "artifactName": "Krug-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@livekit/components-react": "2.9.25",
    "electron-updater": "6.8.11",
    "fastify": "5.12.8",
    "livekit-client": "2.24.0",
    "livekit-server-sdk": "2.19.3",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@livekit/rtc-node": "1.2.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
